# /etc/cron.d/kwbackup — режим 0644, владелец root, имя файла без точек.
# Секреты не попадают в окружение cron автоматически, поэтому читаем их явно.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=root

# ежедневный бэкап
30 3 * * *   root  set -a; . /etc/default/kwbackup; set +a; /usr/local/bin/kwbackup -c /etc/kwbackup/shop.yaml --database --storage --archive >> /var/log/kwbackup/cron.log 2>&1

# еженедельная проверка последней копии (exit 5 = проблема, cron пришлёт письмо)
0  5 * * 0   root  set -a; . /etc/default/kwbackup; set +a; /usr/local/bin/kwbackup -c /etc/kwbackup/shop.yaml --verify >> /var/log/kwbackup/verify.log 2>&1

# ежемесячный отчёт: что лежит в облаке и нет ли дыр
5  6 1 * *   root  set -a; . /etc/default/kwbackup; set +a; /usr/local/bin/kwbackup -c /etc/kwbackup/shop.yaml --list >> /var/log/kwbackup/list.log 2>&1
