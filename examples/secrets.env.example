# /etc/kwbackup/secrets.env — режим 0600, владелец root.
# Подключается через systemd EnvironmentFile= или `. /etc/kwbackup/secrets.env`
# в cron.
#
# Здесь только то, что можно передать через окружение: пароль БД, и, при
# желании, ключи бакетов для подстановки в конфиг (${BEGET_SHOP_KEY}).
# Ключи BEGET в rclone.conf не работают: env_auth = false, поэтому в итоге
# они всё равно уходят флагами --s3-access-key-id / --s3-secret-access-key.
MYSQL_PWD=change-me
BEGET_SHOP_KEY=<ACCESS_KEY_BUCKET_SHOP>
BEGET_SHOP_SECRET=<SECRET_KEY_BUCKET_SHOP>
