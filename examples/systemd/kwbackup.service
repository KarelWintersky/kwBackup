# /etc/systemd/system/kwbackup.service
# Ежедневный прогон. Действия указываются явно: без флагов программа
# ничего не запускает, а только печатает список доступных действий.
[Unit]
Description=kwbackup: backup to S3
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Секреты (ключи S3, пароли БД) — отдельным файлом с правами 0600.
EnvironmentFile=-/etc/default/kwbackup
ExecStart=/usr/local/bin/kwbackup -c /etc/kwbackup/shop.yaml \
    --database --storage --archive

# Бэкап не должен душить прод
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=6h

# Минимальная изоляция.
# /etc/kwbackup читается, поэтому ProtectSystem=full, а не strict.
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/var/log/kwbackup /tmp/kwbackup /run/kwbackup

# Любой ненулевой код возврата = failed unit: видно в systemctl --failed.
# Можно добавить уведомление:
# OnFailure=notify-admin@%n.service
