#!/usr/bin/make -f

%:
	dh $@ --without autoreconf    # no autotools in this project

override_dh_auto_build:
	python3 build.py --version $(shell dpkg-parsechangelog -S Version)

override_dh_installchangelogs:
	# CHANGELOG.md is our project changelog, not the upstream one:
	# keep it as a normal doc file, the Debian changelog stays changelog.gz
	dh_installchangelogs -X CHANGELOG.md

override_dh_auto_test:
	python3 tests/e2e.py

override_dh_auto_install:
	# debian/kwbackup.install and dh_installdocs do the work

override_dh_auto_clean:
	rm -rf dist
